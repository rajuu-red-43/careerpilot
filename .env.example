# CareerPilot v2: Production Environment Variables

# Session Cookie Signing Secret (Min 32 random characters - generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secure-random-32-byte-secret-key-for-session-signing

# Application Base URL (Optional - defaults to auto-detecting host or localhost:3000)
# Production: https://careerpilot-git-main-alpha-8569.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://joitkgweqvxjuavidsoi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Indic Translation & Bhashini API (Server-side)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
