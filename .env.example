# Google OAuth 2.0 Credentials (From Google Cloud Console: APIs & Services > Credentials)
# Required scopes: openid, email, profile
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Session Cookie Signing Secret (Min 32 random characters - generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secure-random-32-byte-secret-key-for-session-signing

# Application Base URL (Optional - defaults to auto-detecting host or localhost:3000)
# Production: https://careerpilot-git-main-alpha-8569.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://joitkgweqvxjuavidsoi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
