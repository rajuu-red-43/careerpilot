# CareerPilot v2: Production Environment Variables (Open Visitor Access)

# Application Base URL (Optional - defaults to auto-detecting host or localhost:3000)
# Production: https://careerpilot-git-main-alpha-8569.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Database Configuration (Public data, skills, courses, roadmaps)
NEXT_PUBLIC_SUPABASE_URL=https://joitkgweqvxjuavidsoi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Platform Administrator Passcode (for /admin console protection)
# Defaults to "admin2026" if unspecified
NEXT_PUBLIC_ADMIN_KEY=admin2026

# Optional Indic Translation & Bhashini API (Server-side)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
